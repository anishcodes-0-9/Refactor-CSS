{
  "name": "refactor-css",
  "version": "0.0.0",
  "description": "A conservative, evidence-based CSS usage analyzer for React/Next.js repositories.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "refactor-css": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishcodes-0-9/Refactor-CSS.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
